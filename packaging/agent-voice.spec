# PyInstaller spec: one folder with two executables sharing the same files.
#   agent-voice.exe    console: CLI, agent hooks, double-click quick start
#   agent-voice-w.exe  no console: background daemon, widget, Windows autostart
# Build: pyinstaller packaging/agent-voice.spec  (run `python packaging/prepare.py` first)
from pathlib import Path

from PyInstaller.utils.hooks import collect_all, collect_submodules

ROOT = Path(SPECPATH).parent

datas, binaries, hiddenimports = [], [], []
# Packages that load data files or native libraries at runtime (voices' espeak data, VAD model,
# CTranslate2 / onnxruntime DLLs, lingua language models).
# lingua is left out (300 MB of models): lang.py falls back to py3langid.
for package in ("piper", "faster_whisper", "ctranslate2", "onnxruntime", "py3langid", "tokenizers", "sherpa_onnx",
                "winpty"):
    d, b, h = collect_all(package)
    datas += d
    binaries += b
    hiddenimports += h
hiddenimports += collect_submodules("agent_voice")
# The browser extension, loaded unpacked from the install folder (`agent-voice install browser` shows where).
datas += [(str(ROOT / "agent_voice" / "browser"), "agent_voice/browser")]
# UI Automation wrappers, generated by packaging/prepare.py (a frozen app can't generate them).
hiddenimports += collect_submodules("comtypes")
# Imported where they're used (the phone's QR code, the audio mixer): listed so the build never misses them.
hiddenimports += collect_submodules("qrcode") + collect_submodules("pycaw") + ["psutil"]

a = Analysis(
    [str(ROOT / "packaging" / "entry.py")],
    pathex=[str(ROOT)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    excludes=["lingua", "tkinter", "matplotlib", "IPython", "pytest", "PIL", "hf_xet"],
    noarchive=False,
)
# Not needed by a QPainter widget: software OpenGL (20 MB) and Qt's UI translations.
a.binaries = [b for b in a.binaries if "opengl32sw" not in b[0]]
a.datas = [d for d in a.datas if "PySide6/translations" not in d[0].replace("\\", "/")]
pyz = PYZ(a.pure)
icon = ROOT / "packaging" / "agent-voice.ico"
common = dict(exclude_binaries=True, upx=False, icon=str(icon) if icon.exists() else None)
console = EXE(pyz, a.scripts, [], name="agent-voice", console=True, **common)
windowed = EXE(pyz, a.scripts, [], name="agent-voice-w", console=False, **common)
COLLECT(console, windowed, a.binaries, a.datas, name="agent-voice", upx=False)
